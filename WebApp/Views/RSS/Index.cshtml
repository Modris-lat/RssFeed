
@{
    ViewData["Title"] = "RSS feed from delfi";
    var feedList = ViewBag.FeedList as HashSet<string>;
}

<div classpadding-bottom">
        <div class="row">
            <div class="col-md-12 ">
                <br />
                <form action="~/RSS/Index" method="post">
                    <div class="panel panel-primary">
                        <div class="panel-heading">
                            <h2>Delfi ziņas</h2>
                        </div>
                        <div class="panel-body">
                            <div class="form-group">
                                <label>Izvēlēties plūsmu</label>
                                <select name="feed" class="form-control">
                                    <option value="" selected disabled hidden>@ViewBag.SelectedFeed</option>
                                @foreach(var feed in feedList)
                                {
                                    <option value="@feed">@feed</option>
                                }
                                </select>
                            </div>
                        </div>
                        <div class="panel-footer">
                            <button type="submit" class="btn btn-success">Rādīt plūsmu</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="col-md-12">
                <div class="panel panel-warning">
                    <div class="panel-heading">
                        <h2 style="padding-top:1%;padding-bottom:1%">@ViewBag.SelectedFeed</h2>
                    </div>

                    <div class="panel-body">
                        
                        @if (ViewBag.RSS != null)
                        {
                            foreach (var item in ViewBag.RSS)
                            {
                            <div class="jobs-well">
                                <h4>@item.Title></h4>
                                <div class="cnt" style="overflow: hidden">@item.Description</div>
                                <a href='@item.Link' target="_blank" class="btn btn-success"><i class="fa fa-check"></i>Lasīt vairāk</a>
                                <hr />
                                
                            </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>